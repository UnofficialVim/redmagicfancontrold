{
    "version": "2.0.0",
    "configurations": [
        {
            "name": "Debug Project",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/redmagicfancontrold",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Build Project"
        },
                {
            "name": "Debug Android",
            "type": "lldb",
            "request": "custom",

            "targetCreateCommands": [
                "platform select remote-android",
                "platform connect connect://127.0.0.1:5039",
                "platform settings -w /data/local/tmp",
                "target create ${workspaceFolder}/build_aarch64/redmagicfancontrold"
            ],

            "processCreateCommands": [
                "process launch"
            ],

            "preLaunchTask": "start lldb-server"
        }
    ]
}