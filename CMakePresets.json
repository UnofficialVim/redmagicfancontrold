{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },

    "configurePresets": [
        {
            "name": "linux",
            "displayName": "Linux Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "aarch64-musl",
            "displayName": "ARM64 musl Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build_aarch64-musl",
            "toolchainFile": "${sourceDir}/cmake/toolchains/aarch64-unknown-linux-musl.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "aarch64",
            "displayName": "Android ARM64 Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build_aarch64",
            "toolchainFile": "$env{ANDROID_NDK}/build/cmake/android.toolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_PLATFORM": "android-35"
            }
        }
    ],

    "buildPresets": [
        {
            "name": "linux",
            "configurePreset": "linux",
            "jobs": 0
        },
        {
            "name": "aarch64-musl",
            "configurePreset": "aarch64",
            "jobs": 0
        },
        {
            "name": "aarch64",
            "configurePreset": "aarch64",
            "jobs": 0
        }
    ],

    "testPresets": [
        {
            "name": "linux",
            "configurePreset": "linux",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}