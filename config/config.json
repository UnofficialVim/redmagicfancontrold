{
    "version": 1,
    "calls_silence_fan": true,
    "log_level": "LOGGER_TRACE",
    "log_path": "rmfc.log",
    "active_profile": "default",
    "fan_device_path": "/sys/kernel/fan",
    "thermal_path":"/sys/class/thermal", 
    "socket_path": "/rmfc_socket",
    "profiles": [
        {
            "name": "default",
            "refresh_rate": 5,
            "fan_curve": {
                "steps": [
                    { "temp_c": 40000, "fan_lvl": 0 },
                    { "temp_c": 50000, "fan_lvl": 2 },
                    { "temp_c": 60000, "fan_lvl": 3 },
                    { "temp_c": 70000, "fan_lvl": 4 },
                    { "temp_c": 80000, "fan_lvl": 5 }
                ]
            }
        },
        {
            "name": "gaming",
            "refresh_rate": 2.5,
            "fan_curve": {
                "steps": [
                    { "temp_c": 35000, "fan_lvl": 1 },
                    { "temp_c": 45000, "fan_lvl": 2 },
                    { "temp_c": 55000, "fan_lvl": 4 },
                    { "temp_c": 65000, "fan_lvl": 5 }
                ]
            }
        }
    ]
}
