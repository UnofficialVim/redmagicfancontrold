{
    "version": 1,
    "calls_silence_fan": true,
    "log_path": "../config/log",
    "log_level": "LOGGER_TRACE",
    "active_profile": "default",
    "fan_device_path": "/sys/kernel/fan",
    "thermal_path":"/sys/class/thermal", 
    "socket_path": "../rmfc_socket",
    "profiles": [
        {
            "name": "default",
            "fan_curve": {
                "steps": [
                    { "temp_c": 40, "fan_lvl": 0 },
                    { "temp_c": 50, "fan_lvl": 2 },
                    { "temp_c": 60, "fan_lvl": 3 },
                    { "temp_c": 70, "fan_lvl": 4 },
                    { "temp_c": 80, "fan_lvl": 5 }
                ]
            }
        },
        {
            "name": "gaming",
            "fan_curve": {
                "steps": [
                    { "temp_c": 35, "fan_lvl": 1 },
                    { "temp_c": 45, "fan_lvl": 2 },
                    { "temp_c": 55, "fan_lvl": 4 },
                    { "temp_c": 65, "fan_lvl": 5 }
                ]
            }
        }
    ]
}
